# Local development credentials. Change these before exposing services publicly.
POSTGRES_DB=tcc
POSTGRES_USER=tcc_user
POSTGRES_PASSWORD=tcc_password

# Host-native application URLs (for `uv run python src/api.py` outside Compose).
# The Compose API uses DOCKER_* overrides below instead, defaulting to service DNS.
POSTGRES_DSN=postgresql+psycopg://tcc_user:tcc_password@localhost:5432/tcc
REDIS_URL=redis://localhost:6379/0
OLLAMA_HOST=http://localhost:11434
SPOTLIGHT_ENDPOINT=http://localhost:2222/rest

# Optional endpoints for the API running inside Compose. Override only when
# connecting that container to services at non-default hosts/ports.
# DOCKER_POSTGRES_DSN=postgresql+psycopg://user:password@host:5432/database
# DOCKER_REDIS_URL=redis://host:6379/0
# DOCKER_OLLAMA_HOST=http://host:11434
# DOCKER_SPOTLIGHT_ENDPOINT=http://host:2222/rest

# Required only for Gemini-backed summarization.
GEMINI_API_KEY=

# Optional host-port overrides.
API_PORT=5000
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434
SPOTLIGHT_PORT=2222
